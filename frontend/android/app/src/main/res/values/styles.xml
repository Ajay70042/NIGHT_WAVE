<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#08080c</item>
        <item name="colorPrimaryDark">#08080c</item>
        <item name="colorAccent">#a3e635</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#08080c</item>
        <item name="android:statusBarColor">#08080c</item>
        <item name="android:navigationBarColor">#08080c</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">#08080c</item>
        <item name="android:navigationBarColor">#08080c</item>
    </style>
</resources>